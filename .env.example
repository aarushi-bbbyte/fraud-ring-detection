# Copy to .env and adjust. Read by docker compose and by the Python backend.

NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Neo4j memory (heap is used for queries and GDS projections, page cache for the store).
NEO4J_HEAP=1g
NEO4J_PAGECACHE=1200m

# Throwaway Neo4j used only by pytest (docker compose --profile test up -d neo4j-test).
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_HTTP_PORT=7475
NEO4J_TEST_BOLT_PORT=7688

# Where the IBM AML dataset lives (relative to the repo root).
DATA_DIR=data
DATASET=HI-Small
